---
import { withBase } from '../lib/paths';

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<div class="tags">
			{tags.map((tag) => (
				<a class="tag" href={withBase(`tags/${encodeURIComponent(tag)}/`)}>
					{tag}
				</a>
			))}
		</div>
	)
}
