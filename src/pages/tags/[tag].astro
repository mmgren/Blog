---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, postsByTag, uniqueTags } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return uniqueTags(posts).map((tag) => ({
		params: { tag },
	}));
}

const { tag } = Astro.params;
const posts = postsByTag(await getPublishedPosts(), tag ?? '');
---

<BaseLayout title={`标签：${tag}`} description={`带有「${tag}」标签的技术笔记。`}>
	<section class="hero">
		<h1>{tag}</h1>
		<p class="lede">这个主题下共有 {posts.length} 篇笔记。</p>
	</section>
	<PostList posts={posts} />
</BaseLayout>
